# ══════════════════════════════════════════════════════════════════════════
#  ENTORNO: PRODUCCIÓN (PROD)
#  Uso:  scripts\deploy-prod.bat  →  copia este archivo a .env en el VPS
#  ⚠️  REEMPLAZA TODOS LOS VALORES "CHANGE_ME_*" ANTES DE USAR
#  ⚠️  NUNCA subir este archivo con secretos reales al repositorio
# ══════════════════════════════════════════════════════════════════════════

# ── Aplicación ─────────────────────────────────────────────────────────
APP_NAME="Kapitalya"
APP_ENV=production
APP_KEY=CHANGE_ME_base64_32_chars_random_key
APP_DEBUG=false
APP_URL=https://CHANGE_ME_TU_DOMINIO.com
APP_VERSION=1.0.0

# ── Logging — rotación diaria, nivel ERROR ────────────────────────────
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_SLACK_WEBHOOK_URL=CHANGE_ME_slack_webhook_url_opcional
LOG_SLACK_LEVEL=critical

# ── Base de datos: kapitalya_prod ──────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kapitalya_prod
DB_USERNAME=kapitalya_prod
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_ROOT_PASSWORD=CHANGE_ME_strong_root_password

# ── Cache / Sesiones (Redis con contraseña) ───────────────────────────
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local
BROADCAST_DRIVER=log

# ── Redis (con contraseña en producción) ──────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_PORT=6379

# ── Mail (SMTP real) ───────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME_smtp_host
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_smtp_user
MAIL_PASSWORD=CHANGE_ME_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@CHANGE_ME_TU_DOMINIO.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Monitoreo Sentry (recomendado para fintech) ───────────────────────
SENTRY_LARAVEL_DSN=CHANGE_ME_sentry_dsn_opcional

# ── Seguridad adicional ────────────────────────────────────────────────
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=CHANGE_ME_TU_DOMINIO.com
