# ══════════════════════════════════════════════════════════════════════════
#  ENTORNO: TESTING / STAGING (TEST)
#  Uso:  scripts\setup-test.bat  →  copia este archivo a .env
#  SEGURO para git: sin secretos reales, solo defaults de testing
# ══════════════════════════════════════════════════════════════════════════

# ── Aplicación ─────────────────────────────────────────────────────────
APP_NAME="Kapitalya [TEST]"
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8081
APP_VERSION=test

# ── Logging — archivos detallados, nivel INFO ──────────────────────────
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_LEVEL=critical

# ── Base de datos: kapitalya_test ──────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kapitalya_test
DB_USERNAME=kapitalya_test
DB_PASSWORD=test_secret
DB_ROOT_PASSWORD=root_test_secret

# ── Cache / Sesiones ───────────────────────────────────────────────────
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local
BROADCAST_DRIVER=log

# ── Redis ──────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail — capturado en log, no sale al exterior ───────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@kapitalya.test"
MAIL_FROM_NAME="${APP_NAME}"

# ── Monitoreo ─────────────────────────────────────────────────────────
SENTRY_LARAVEL_DSN=
