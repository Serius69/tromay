# ══════════════════════════════════════════════════════════════════════════
#  ENTORNO: DESARROLLO (DEV)
#  Uso:  scripts\setup-dev.bat   →  copia este archivo a .env
#  SEGURO para git: sin secretos reales, solo defaults locales
# ══════════════════════════════════════════════════════════════════════════

# ── Aplicación ─────────────────────────────────────────────────────────
APP_NAME="Kapitalya [DEV]"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_VERSION=dev

# ── Logging — consola + archivo, nivel DEBUG ───────────────────────────
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_LEVEL=critical

# ── Base de datos: kapitalya_dev ───────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kapitalya_dev
DB_USERNAME=kapitalya_dev
DB_PASSWORD=dev_secret
DB_ROOT_PASSWORD=root_dev_secret

# ── Cache / Sesiones (Redis en Docker) ────────────────────────────────
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local
BROADCAST_DRIVER=log

# ── Redis ──────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail — capturado por Mailpit (http://localhost:8025) ───────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@kapitalya.dev"
MAIL_FROM_NAME="${APP_NAME}"

# ── Monitoreo ─────────────────────────────────────────────────────────
SENTRY_LARAVEL_DSN=
