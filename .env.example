# ── Application ────────────────────────────────────────────────────
APP_NAME=Kapitalya
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_VERSION=dev

# ── Logging ────────────────────────────────────────────────────────
# local: daily | production: daily (rotate 30d) or stderr (Docker)
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Slack alerts for critical errors (production only)
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_LEVEL=critical

# ── Database ───────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kapitalya
DB_USERNAME=root
DB_PASSWORD=root
DB_ROOT_PASSWORD=

# ── Cache / Sessions ────────────────────────────────────────────────
# local: file | production: redis
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_DRIVER=log

# ── Redis (production cache + sessions) ────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ───────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@kapitalya.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── External Exchange Rate API ─────────────────────────────────────
# Base URL for the external rates API (leave empty to use internal DB rates)
# Endpoints used: /exchange-rates/primary/ | /exchange-rates/sources-live/ | /exchange-rates/calculate/
EXCHANGE_API_URL=

# ── Monitoring (optional) ──────────────────────────────────────────
# Register at sentry.io — free tier is enough for a fintech MVP
SENTRY_LARAVEL_DSN=
