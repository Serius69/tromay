# tromay — variables de entorno para produccion
# Copiar a .env y rellenar los valores reales
# NUNCA commitear el .env con valores reales

APP_URL=https://tu-dominio.com

# Base de datos MySQL
DB_PASSWORD=password_seguro_aqui
DB_ROOT_PASSWORD=root_password_seguro_aqui

# Redis
REDIS_PASSWORD=redis_password_seguro_aqui

# Laravel App Key — generar con: php artisan key:generate --show
APP_KEY=base64:CAMBIAR_POR_KEY_REAL

# ── Forex-ERP — fuente primaria de tasas de cambio ──
# Tromay es una vitrina pública: las tasas que muestra provienen de forex-erp.
# Apunta a la base de la API de rates (sin barra final). Si queda vacío, el sitio
# usa como fallback los valores sembrados en la tabla `cashes`.
# Dev (forex-erp por nginx):     http://localhost:9092/api/rates
# Prod (público, en ALLOWED_HOSTS): https://forex.kapitalya.com.bo/api/rates
# K8s (namespace private):       http://forex-erp-backend:8007/api/rates
EXCHANGE_API_URL=
# Margen comercial mínimo compra/venta (%). Si forex trae spread menor, se ensancha
# alrededor del punto medio. USD ya viene ~8%; EUR/BRL/PEN/ARS/CLP casi plano. 0 = off.
EXCHANGE_MIN_SPREAD_PCT=2.5

# ── Monetización — anuncios (AdSense) y analítica (opcional) ──
# Vacío = desactivado: no se carga ningún script de terceros y solo hay cookies
# técnicas. Al poner el pub-id de AdSense aparece el banner de consentimiento y los
# anuncios se cargan SOLO tras aceptar. Habilitá "Auto ads" en el panel de AdSense.
ADSENSE_CLIENT=          # ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_SLOT=            # id de bloque display responsive (opcional, para el slot fijo del footer)
GA_MEASUREMENT_ID=       # G-XXXXXXXXXX (Google Analytics 4, opcional)

# ── docker-compose.dev.yml / docker-compose.test.yml (servicio mysql) ──
# Valor dev usado por docker-compose.dev.yml; docker-compose.test.yml usa
# sus propios valores test_secret / root_test_secret al momento de correr tests.
MYSQL_PASSWORD=dev_secret
MYSQL_ROOT_PASSWORD=root_dev_secret

# Valor dev usado por docker-compose.dev.yml (servicio app)
APP_DEBUG=true

# ── docker-compose.dev.yml / docker-compose.test.yml (servicio app, clave DB_PASSWORD) ──
# NOTA: DB_PASSWORD ya está definido arriba (bloque "Base de datos MySQL") para
# docker-compose.yml / docker-compose.prod.yml. docker-compose.dev.yml usa
# DB_PASSWORD=dev_secret y docker-compose.test.yml usa DB_PASSWORD=test_secret como
# valores de referencia; no se duplica la clave aquí para evitar colisión con el
# DB_PASSWORD de producción.
